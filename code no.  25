<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Graphic Design Poster</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #e6e6e6;
            font-family: 'Helvetica Neue', Arial, sans-serif;
        }
        .poster {
            width: 400px;
            height: 550px;
            background-color: #1a1a1a;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px;
        }
        /* Abstract Geometric Graphic */
        .graphic-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }
        .circle {
            position: absolute;
            width: 300px;
            height: 300px;
            background-color: #ff3333;
            border-radius: 50%;
            top: -50px;
            right: -50px;
        }
        .stripe {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 150px;
            background: linear-gradient(45deg, #ffcc00 25%, transparent 25%), 
                        linear-gradient(-45deg, #ffcc00 25%, transparent 25%);
            background-size: 30px 30px;
            opacity: 0.2;
        }
        /* Typography */
        h1 {
            color: #ffffff;
            font-size: 3.5rem;
            font-weight: 900;
            line-height: 0.9;
            z-index: 2;
            text-transform: uppercase;
            letter-spacing: -2px;
        }
        p {
            color: #ffcc00;
            font-size: 1rem;
            font-weight: 500;
            z-index: 2;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
    </style>
</head>
<body>

    <div class="poster">
        <!-- Graphic Elements -->
        <div class="graphic-container">
            <div class="circle"></div>
            <div class="stripe"></div>
        </div>
        
        <!-- Text Elements -->
        <h1>Art<br>Meets<br>Code.</h1>
        <p>领 Creative Studio © 2026</p>
    </div>

</body>
</html>
