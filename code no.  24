<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Date Difference Calculator</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 50px;
            background-color: #f4f4f9;
        }
        .container {
            max-width: 400px;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        label, input, button {
            display: block;
            width: 100%;
            margin-bottom: 15px;
            font-size: 16px;
        }
        input {
            padding: 8px;
            box-sizing: border-box;
        }
        button {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 10px;
            cursor: pointer;
            border-radius: 4px;
        }
        button:hover {
            background-color: #0056b3;
        }
        .result {
            font-weight: bold;
            font-size: 18px;
            color: #333;
            margin-top: 15px;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Days Calculator</h2>
    
    <label for="startDate">Start Date:</label>
    <input type="date" id="startDate">

    <label for="endDate">End Date:</label>
    <input type="date" id="endDate">

    <button onclick="calculateDays()">Calculate Difference</button>

    <div class="result" id="resultDisplay"></div>
</div>

<script>
function calculateDays() {
    const dateInput1 = document.getElementById('startDate').value;
    const dateInput2 = document.getElementById('endDate').value;

    // Check if both dates are selected
    if (!dateInput1 || !dateInput2) {
        document.getElementById('resultDisplay').innerText = "Please select both dates.";
        return;
    }

    const date1 = new Date(dateInput1);
    const date2 = new Date(dateInput2);
    
    // Calculate the difference in milliseconds
    const differenceInMs = Math.abs(date2 - date1);
    
    // Convert milliseconds to days (1000ms * 60s * 60m * 24h)
    const millisecondsPerDay = 1000 * 60 * 60 * 24;
    const differenceInDays = Math.floor(differenceInMs / millisecondsPerDay);
    
    // Display the result
    document.getElementById('resultDisplay').innerText = `Result: ${differenceInDays} days`;
}
</script>

</body>
</html>
