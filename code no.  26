<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus QR Attendance System</title>
    <!-- Tailwind CSS for modern campus UI layout -->
    <script src="https://jsdelivr.net"></script>
    <!-- QRCode.js Library for generating scanner codes dynamically -->
    <script src="https://cloudflare.com"></script>
</head>
<body class="bg-slate-50 font-sans text-slate-800 min-h-screen">

    <!-- Navigation Header -->
    <header class="bg-indigo-900 text-white shadow-md p-4">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold tracking-wide">🎓 SmartCampus Attendance</h1>
            <span class="bg-indigo-700 px-3 py-1 rounded text-sm font-medium">Portal v2.6</span>
        </div>
    </header>

    <main class="max-w-6xl mx-auto p-4 md:p-8 grid md:grid-cols-2 gap-8">
        
        <!-- LEFT COLUMN: GENERATOR & DISPLAY (For Projector/Teacher) -->
        <section class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex flex-col items-center text-center">
            <h2 class="text-lg font-bold text-indigo-900 mb-2">1. Class Scanner Code</h2>
            <p class="text-sm text-slate-500 mb-6">Display this on the classroom screen. Students scan this code to open the check-in form.</p>
            
            <!-- Live QR Code target element -->
            <div id="qrcode" class="p-4 bg-white border-2 border-dashed border-indigo-200 rounded-xl mb-6"></div>
            
            <div class="w-full text-left bg-slate-50 p-4 rounded-xl text-xs space-y-2 text-slate-600">
                <p><strong>Target URL encoded:</strong> <span id="encodedUrl" class="text-indigo-600 break-all font-mono"></span></p>
                <p><strong>Status:</strong> <span class="text-emerald-600 font-semibold">● Active & Accepting Responses</span></p>
            </div>
        </section>

        <!-- RIGHT COLUMN: STUDENT FORM (Simulates Mobile Scan Destination) -->
        <section class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
            <h2 class="text-lg font-bold text-indigo-900 mb-2">2. Student Attendance Form</h2>
            <p class="text-sm text-slate-500 mb-6">Fill in your exact college details to register your presence for this lecture.</p>
            
            <form id="attendanceForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Full Name</label>
                    <input type="text" id="studentName" required placeholder="e.g. John Doe" 
                           class="w-full p-3 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-600 text-sm">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Roll Number / Student ID</label>
                    <input type="text" id="rollNumber" required placeholder="e.g. CS-2026-089" 
                           class="w-full p-3 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-600 text-sm">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1">Department / Branch</label>
                    <select id="department" required class="w-full p-3 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-600 text-sm bg-white">
                        <option value="">Select Department</option>
                        <option value="Computer Science">Computer Science & Eng.</option>
                        <option value="Information Technology">Information Technology</option>
                        <option value="Electronics">Electronics & Comm.</option>
                        <option value="Mechanical">Mechanical Engineering</option>
                    </select>
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium p-3 rounded-xl transition-all shadow-sm shadow-indigo-200 text-sm">
                    Submit Attendance Verification
                </button>
            </form>

            <!-- Inline Success Toast Notifications -->
            <div id="successMsg" class="hidden mt-4 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm text-center font-medium">
                ✅ Attendance successfully logged!
            </div>
        </section>

    </main>

    <!-- Real-time dynamic behaviors -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // 1. Simulate the dynamic URL that the QR code would point to in production
            const currentDomain = window.location.href.split('?')[0];
            const checkInUrl = `${currentDomain}?form=attendance_portal_active`;
            
            document.getElementById('encodedUrl').innerText = checkInUrl;

            // 2. Initialize and render the QR scanner code using the script library
            new QRCode(document.getElementById("qrcode"), {
                text: checkInUrl,
                width: 200,
                height: 200,
                colorDark : "#1e1b4b", // Deep indigo
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H
            });

            // 3. Handle Form Submission event
            const form = document.getElementById('attendanceForm');
            const successMsg = document.getElementById('successMsg');

            form.addEventListener('submit', (e) => {
                e.preventDefault();
                
                // Collect input values
                const data = {
                    name: document.getElementById('studentName').value,
                    roll: document.getElementById('rollNumber').value,
                    dept: document.getElementById('department').value,
                    timestamp: new Date().toLocaleTimeString()
                };

                console.log("Logged to Dashboard Database Mock:", data);

                // UI Feedback transition
                form.reset();
                successMsg.classList.remove('hidden');
                
                setTimeout(() => {
                    successMsg.classList.add('hidden');
                }, 4000);
            });
        });
    </script>
</body>
</html>
