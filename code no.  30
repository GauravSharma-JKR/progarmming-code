import React, { useState } from 'react';


const StatusCard = ({ label, value, colorClass }) => {
  return (
    <div className="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
      <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider">{label}</span>
      <span className={`text-2xl font-bold mt-2 ${colorClass}`}>{value}</span>
    </div>
  );
};


export default function GradeBookDashboard() {
  
  const initialRegistryData = [
    { id: "STU-01", name: "Rahul Sharma", subject: "Advanced AI", score: 92 },
    { id: "STU-02", name: "Priya Patel", subject: "Data Structures", score: 88 },
    { id: "STU-03", name: "Amit Verma", subject: "Discrete Mathematics", score: 64 },
    { id: "STU-04", name: "Sarah Lin", subject: "Advanced AI", score: 79 }
  ];

  
  const [students, setStudents] = useState(initialRegistryData);
  const [formData, setFormData] = useState({ name: '', subject: '', score: '' });

  
  const totalStudents = students.length;
  const classAverage = totalStudents > 0 
    ? parseFloat((students.reduce((sum, s) => sum + Number(s.score), 0) / totalStudents).toFixed(1))
    : 0;
  const failingCount = students.filter(s => s.score < 75).length;

  
  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
  };

  
  const handleAddStudent = (e) => {
    e.preventDefault();
    if (!formData.name || !formData.subject || !formData.score) return;

    const newEntry = {
      id: `STU-${Date.now().toString().slice(-2)}`,
      name: formData.name,
      subject: formData.subject,
      score: Math.min(100, Math.max(0, Number(formData.score))) // Boundary enforcement (0-100)
    };

    setStudents(prev => [newEntry, ...prev]);
    setFormData({ name: '', subject: '', score: '' }); // Form Reset Array
  };

  
  const handleDeleteRow = (id) => {
    setStudents(prev => prev.filter(student => student.id !== id));
  };

  
  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 p-4 md:p-8 font-sans">
      
      
      <header className="max-w-6xl mx-auto mb-8">
        <h1 className="text-2xl font-bold text-slate-900 tracking-tight">🎓 Faculty GradeBook Terminal</h1>
        <p className="text-sm text-slate-500">Real-time academic evaluation & dataset ingestion console.</p>
      </header>

      
      <section className="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        <StatusCard label="Active Cohorts Enrolled" value={totalStudents} colorClass="text-indigo-600" />
        <StatusCard label="Class Assessment Average" value={`${classAverage}%`} colorClass="text-emerald-600" />
        <StatusCard label="Attendance / Progress Warnings" value={failingCount} colorClass="text-rose-600" />
      </section>

      
      <main className="max-w-6xl mx-auto grid lg:grid-cols-3 gap-8">
        
       
        <div className="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm h-fit">
          <h3 className="font-bold text-slate-900 mb-4 text-base">Add Student Evaluation</h3>
          <form onSubmit={handleAddStudent} className="space-y-4">
            <div>
              <label className="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Student Name</label>
              <input type="text" name="name" value={formData.name} onChange={handleInputChange} required placeholder="e.g. John Doe"
                     className="w-full p-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500" />
            </div>
            <div>
              <label className="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Course Domain</label>
              <input type="text" name="subject" value={formData.subject} onChange={handleInputChange} required placeholder="e.g. Operating Systems"
                     className="w-full p-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500" />
            </div>
            <div>
              <label className="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Assigned Grade Score (%)</label>
              <input type="number" name="score" value={formData.score} onChange={handleInputChange} required min="0" max="100" placeholder="0 - 100"
                     className="w-full p-2.5 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500" />
            </div>
            <button type="submit" className="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium p-3 rounded-xl text-sm transition-all shadow-sm">
              Commit Entry to Registry
            </button>
          </form>
        </div>

        
        <div className="lg:col-span-2 bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden flex flex-col">
          <div className="p-4 bg-slate-900 text-white text-xs font-medium uppercase tracking-wider">
            Active Roster Log Array Matrix
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-left border-collapse text-sm">
              <thead>
                <tr className="bg-slate-50 text-slate-500 border-b border-slate-100 text-xs font-semibold">
                  <th className="p-4">ID</th>
                  <th className="p-4">Student</th>
                  <th className="p-4">Subject</th>
                  <th className="p-4">Score</th>
                  <th className="p-4 text-center">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-50">
                {students.map((student) => (
                  <tr key={student.id} className="hover:bg-slate-50/70 transition-colors">
                    <td className="p-4 font-mono text-xs text-slate-400">{student.id}</td>
                    <td className="p-4 font-semibold text-slate-900">{student.name}</td>
                    <td className="p-4 text-slate-600">{student.subject}</td>
                    <td className="p-4">
                      <span className={`px-2.5 py-0.5 rounded-full font-bold text-xs ${
                        student.score >= 90 ? 'bg-emerald-50 text-emerald-700' :
                        student.score >= 75 ? 'bg-amber-50 text-amber-700' : 'bg-rose-50 text-rose-700'
                      }`}>
                        {student.score}%
                      </span>
                    </td>
                    <td className="p-4 text-center">
                      <button onClick={() => handleDeleteRow(student.id)} 
                              className="text-rose-500 hover:text-rose-700 font-medium text-xs px-2 py-1 rounded transition-colors">
                        Delete
                      </button>
                    </td>
                  </tr>
                ))}
                {totalStudents === 0 && (
                  <tr>
                    <td colSpan="5" className="p-8 text-center text-slate-400 italic">
                      No matching record parameters exist inside storage fields.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

      </main>
    </div>
  );
}
