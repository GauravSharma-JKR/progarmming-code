
class AcademicSystemException extends Error {
    constructor(message, errorCode) {
        super(message);
        this.name = "AcademicSystemException";
        this.errorCode = errorCode;
        this.timestamp = new Date().toISOString();
    }
}


class UserProfile {
    #internalSecurityKey; // Encapsulated private field mapping (ES2020 feature)

    constructor(id, name, email) {
        if (this.constructor === UserProfile) {
            throw new AcademicSystemException("Cannot instantiate abstract UserProfile directly.", "ERR_ABSTRACT_INSTANTIATION");
        }
        this.id = id;
        this.name = name;
        this.email = email;
        this.#internalSecurityKey = Math.random().toString(36).substring(2, 11).toUpperCase();
        this.accountCreated = new Date();
    }


    get verificationTag() {
        return `USER-${this.id}-${this.name.split(' ')[0].toUpperCase()}`;
    }

    getDetailsSummary() {
        return `ID: ${this.id} | Name: ${this.name} | Contact: ${this.email}`;
    }
}


class Student extends UserProfile {
    constructor(id, name, email, department) {
        super(id, name, email);
        this.department = department;
        this.enrolledCourses = new Map(); // Dynamic Course Registry Storage Map
        this.academicTranscript = [];     // Array mapping historical grades
    }

   registerCourse(courseCode, courseDetails) {
        if (this.enrolledCourses.has(courseCode)) {
            throw new AcademicSystemException(`Enrollment Failure: Course ${courseCode} is already registered.`, "ERR_DUPLICATE_COURSE");
        }
        
        const enrollmentRecord = {
            ...courseDetails,
            dateEnrolled: new Date(),
            attendanceLogs: [],
            status: "Active"
        };
        
        this.enrolledCourses.set(courseCode, enrollmentRecord);
        return true;
    }


    logAttendance(courseCode, status = "Present") {
        if (!this.enrolledCourses.has(courseCode)) {
            throw new AcademicSystemException(`Operation Aborted: Student is not registered in ${courseCode}`, "ERR_INVALID_COURSE_ACCESS");
        }
        
        const course = this.enrolledCourses.get(courseCode);
        course.attendanceLogs.push({
            date: new Date().toLocaleDateString(),
            status: status
        });
    }


    postFinalGrade(courseCode, numericalScore) {
        if (!this.enrolledCourses.has(courseCode)) {
            return false;
        }

        this.academicTranscript.push({
            courseCode: courseCode,
            title: this.enrolledCourses.get(courseCode).title,
            credits: this.enrolledCourses.get(courseCode).credits || 3,
            score: numericalScore
        });


        this.enrolledCourses.delete(courseCode);
        return true;
    }


    calculateGPA() {
        if (this.academicTranscript.length === 0) return 0.00;


        const totalPoints = this.academicTranscript.reduce((accumulator, record) => {
            let gradePoint = 0;
            if (record.score >= 90) gradePoint = 4.0;
            else if (record.score >= 80) gradePoint = 3.0;
            else if (record.score >= 75) gradePoint = 2.5;
            else if (record.score >= 60) gradePoint = 2.0;
            else gradePoint = 0.0;

            return accumulator + (gradePoint * record.credits);
        }, 0);

        const totalCredits = this.academicTranscript.reduce((acc, current) => acc + current.credits, 0);
        return totalCredits === 0 ? 0.00 : parseFloat((totalPoints / totalCredits).toFixed(2));
    }


    getDetailsSummary() {
        return `${super.getDetailsSummary()} | Dept: ${this.department} | Current GPA: ${this.calculateGPA()}`;
    }
}


const AcademyNetworkController = {
    mockServerDelay: (ms) => new Promise(resolve => setTimeout(resolve, ms)),


    async fetchGlobalCourseCatalog() {

        await this.mockServerDelay(1200);


        if (Math.random() > 0.95) {
            throw new AcademicSystemException("Cloud Registry Handshake Timeout", "ERR_SERVER_OFFLINE");
        }

        return [
            { code: "CS-101", title: "Introduction to Computer Architecture", credits: 4 },
